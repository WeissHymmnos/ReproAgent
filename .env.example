# LLM
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_VISION_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.0
LLM_SEED=42

# Parser
PARSER_BACKEND=finpdfpro
FINPDFPRO_MODE=balanced
FINPDFPRO_VLM_BACKEND=none
PARSER_VERSION=1.0.0

# Data
DATA_SOURCE=local
RICEQUANT_TOKEN=
RQ_USER=
RQ_PASS=
RQ_TOKEN=
TUSHARE_TOKEN=
QLIB_CN_DATA_PATH=
LOCAL_DATA_PATH=

# Storage (defaults to ~/.reproagent)
# DATA_DIR=~/.reproagent

# Reflection
MAX_REFLECTION_ITERATIONS=3

# TUI
TUI_THEME=dark
